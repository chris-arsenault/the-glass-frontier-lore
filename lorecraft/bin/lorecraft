#!/usr/bin/env ruby
# frozen_string_literal: true

# Lorecraft CLI — task-sized views over one canonical DSL world.
# Run `ruby lorecraft/bin/lorecraft help` for commands and JIT authoring topics.
#
# Every content command runs against exactly one world. Pick it with `--world
# <id>` or LORECRAFT_WORLD; otherwise the manifest default is used. Help does
# not load a world.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
require "json"
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "lorecraft"

def opt(args, flag, default = nil)
  i = args.index(flag)
  return default unless i

  val = args[i + 1]
  if val.nil? || val.start_with?("-")
    warn "#{flag} requires a value"
    exit 2
  end
  args.delete_at(i + 1)
  args.delete_at(i)
  val
end

def emit(query, format)
  puts(format == :json ? JSON.pretty_generate(query.data) : query.report)
end

# Record explicit global selectors before stripping them. Command help is the
# contract for which selectors a command uses; silently ignoring another one
# would make a precise-looking query return the wrong view.
explicit_selectors = %w[--world --audience --at --format].select { |flag| ARGV.include?(flag) }

# --world appears after the subcommand in normal usage, so strip it before
# reading that subcommand. Resolve the manifest after help dispatch so JIT
# documentation also works outside a repo.
world_id = opt(ARGV, "--world", ENV["LORECRAFT_WORLD"])
cmd = ARGV.shift || "validate"

if %w[help --help -h].include?(cmd)
  topic = ARGV.shift
  output = Lorecraft::CLIHelp.render(topic)
  unless output
    warn "unknown help topic: #{topic}"
    warn "known commands: #{Lorecraft::CLIHelp::COMMANDS.keys.join(', ')}"
    warn "known topics: #{Lorecraft::CLIHelp::TOPICS.join(', ')}"
    exit 2
  end
  puts output
  exit
end

if (help_flag = ARGV.index { |arg| %w[--help -h].include?(arg) })
  ARGV.delete_at(help_flag)
  output = Lorecraft::CLIHelp.render(cmd)
  unless output
    warn "no help for unknown command: #{cmd}"
    exit 2
  end
  puts output
  exit
end

if (doc = Lorecraft::CLIHelp::COMMANDS[cmd])
  unsupported = explicit_selectors.reject { |flag| doc.fetch(:usage).include?(flag) }
  unless unsupported.empty?
    help_command = "#{Lorecraft::CLIHelp::EXE} help #{cmd}"
    warn "not supported by #{cmd}: #{unsupported.join(', ')}; run `#{help_command}`"
    exit 2
  end
end

WORLD = begin
  Lorecraft::Worlds.find(world_id)
rescue Lorecraft::Error => e
  warn e.message
  exit 2
end

# LORECRAFT_GLOB still overrides the manifest, for one-off runs over a subset.
GLOB = ENV.fetch("LORECRAFT_GLOB", WORLD.glob)

def load_world(format: :text)
  Lorecraft.load(GLOB, prelude: WORLD.prelude)
rescue StandardError, SyntaxError => e
  if format == :json
    diagnostic = Lorecraft::Diagnostic.new(
      severity: :error,
      code: e.is_a?(SyntaxError) ? "invalid_ruby_source" : "world_load_error",
      message: e.message,
      repair_instruction: "Correct the world source or selector and rerun the command.",
      help_topic: "workflow",
      details: { error_class: e.class.name }
    )
    puts JSON.pretty_generate(schema_version: 1, status: "error", diagnostics: [diagnostic.to_h])
  else
    warn "load error: #{e.message}"
  end
  exit 2
end

audience = opt(ARGV, "--audience", "all").to_sym
unless %i[all player].include?(audience)
  warn "--audience must be all or player"
  exit 2
end

at_arg = opt(ARGV, "--at", "now")
at = begin
  at_arg == "now" ? :now : Integer(at_arg)
rescue ArgumentError
  warn "--at must be now or an integer year"
  exit 2
end

format = opt(ARGV, "--format", "text").to_sym
unless %i[text json].include?(format)
  warn "--format must be text or json"
  exit 2
end
format_supported = Lorecraft::CLIHelp::COMMANDS.dig(cmd, :usage)&.include?("--format")
if format == :json && !format_supported
  warn "--format json is not supported by #{cmd}"
  exit 2
end

case cmd
when "validate"
  world = load_world(format: format)
  diagnostics = world.validation_diagnostics(root: Lorecraft::Worlds.repo_root)
  if format == :json
    puts JSON.pretty_generate(
      schema_version: 1,
      status: diagnostics.empty? ? "ok" : "error",
      diagnostics: diagnostics.map(&:to_h)
    )
  elsif diagnostics.empty?
    puts "✓ world is valid"
  else
    puts "✗ #{diagnostics.size} problem(s):"
    diagnostics.each { |diagnostic| puts "  - #{diagnostic.message}" }
  end
  unless diagnostics.empty?
    exit 1
  end
when "lint"
  world = load_world(format: format)
  results = if format == :json
              world.lint_diagnostics(root: Lorecraft::Worlds.repo_root)
            else
              world.lint
            end
  by = results.group_by(&:level)
  e = (by[:error] || []).size
  w = (by[:warn] || []).size
  fu = (by[:future] || []).size
  i = (by[:info] || []).size
  if format == :json
    puts JSON.pretty_generate(
      schema_version: 1,
      status: e.positive? ? "error" : "ok",
      counts: { error: e, warn: w, future: fu, info: i },
      diagnostics: results.map(&:to_h)
    )
  else
    %i[info future warn error].each do |lvl|
      (by[lvl] || []).each { |f| puts "#{lvl.to_s.upcase.ljust(7)} #{f.message}" }
    end
    puts "\n#{'─' * 40}\n  #{e} error(s), #{w} warning(s), #{fu} future(s), #{i} to convert"
  end
  exit(e.positive? ? 1 : 0)
when "wiki"
  out = ARGV.shift or abort("usage: #{Lorecraft::CLIHelp::EXE} wiki OUT_DIR")
  files = load_world.render(:wiki, out: out, at: at)
  puts "generated #{files.size} wiki pages → #{out}/"
when "topology"
  emit(Lorecraft::Topology.new(load_world), format)
when "focus"
  emit(Lorecraft::FocusCoverage.new(load_world, at: at), format)
when "worlds"
  Lorecraft::Worlds.all.each do |w|
    marks = w.status.to_s
    default = " (default)" if w.id == Lorecraft::Worlds.default_id
    puts "  #{w.id.ljust(16)} #{w.title.ljust(24)} #{marks}#{default}"
  end
when "search"
  kind = opt(ARGV, "--kind")
  tag = opt(ARGV, "--tag")
  limit_arg = opt(ARGV, "--limit", Lorecraft::Search::DEFAULT_LIMIT.to_s)
  limit = begin
    Integer(limit_arg)
  rescue ArgumentError
    warn "--limit must be a positive integer"
    exit 2
  end
  if limit < 1
    warn "--limit must be a positive integer"
    exit 2
  end
  query = ARGV.join(" ").strip
  abort("usage: #{Lorecraft::CLIHelp::EXE} search QUERY") if query.empty?
  w = load_world
  if kind && !w.schema.kind?(kind)
    abort "unknown entity kind: #{kind}"
  end
  if tag && !w.schema.tags.key?(tag.to_sym)
    abort "unknown tag: #{tag}"
  end
  query = Lorecraft::Search.new(
    w,
    query: query,
    root: Lorecraft::Worlds.repo_root,
    audience: audience,
    at: at,
    kind: kind,
    tag: tag,
    limit: limit,
  )
  emit(query, format)
when "connections"
  id = ARGV.shift or abort("usage: #{Lorecraft::CLIHelp::EXE} connections ID")
  begin
    query = Lorecraft::Connections.new(
      load_world,
      entity: id.tr("-", "_").to_sym,
      root: Lorecraft::Worlds.repo_root,
      audience: audience,
      at: at,
    )
    emit(query, format)
  rescue Lorecraft::Error => e
    abort e.message
  end
when "path"
  max_hops_arg = opt(ARGV, "--max-hops", Lorecraft::PathQuery::DEFAULT_MAX_HOPS.to_s)
  from = ARGV.shift or abort("usage: #{Lorecraft::CLIHelp::EXE} path FROM TO")
  to = ARGV.shift or abort("usage: #{Lorecraft::CLIHelp::EXE} path FROM TO")
  max_hops = begin
    Integer(max_hops_arg)
  rescue ArgumentError
    warn "--max-hops must be an integer"
    exit 2
  end
  begin
    query = Lorecraft::PathQuery.new(
      load_world,
      from: from,
      to: to,
      at: at,
      audience: audience,
      max_hops: max_hops,
    )
    emit(query, format)
  rescue Lorecraft::Error => e
    abort e.message
  end
when "schema"
  topic = ARGV.shift || "kinds"
  name = ARGV.shift
  begin
    emit(Lorecraft::SchemaInspection.new(load_world, topic: topic, name: name), format)
  rescue Lorecraft::Error => e
    abort e.message
  end
when "guide"
  name = ARGV.shift || "list"
  begin
    guide = Lorecraft::Guide.new(WORLD, repo_root: Lorecraft::Worlds.repo_root)
    puts(format == :json ? JSON.pretty_generate(guide.data(name)) : guide.report(name))
  rescue Lorecraft::Error => e
    abort e.message
  end
when "review"
  abort <<~MSG
    `review` is gone. Review state lives on the content:

      reviewed "YYYY-MM-DD"   on the entity, once a human has read it
      status :complete        when the entry is finished

    `#{Lorecraft::CLIHelp::EXE} provenance` reports what has been read and whose read expired.
  MSG
when "render"
  out = ARGV.shift or abort(
    "usage: #{Lorecraft::CLIHelp::EXE} render OUT_DIR [--audience player] [--at YEAR]"
  )
  w = load_world
  w.validate! rescue (warn "refusing to render an invalid world; run `lorecraft validate`"; exit 1)
  files = w.render(:markdown, out: out, audience: audience, at: at)
  puts "rendered #{files.size} pages → #{out}/"
when "graph"
  out = ARGV.shift
  json = load_world.render(:graph, audience: audience, at: at)
  if out
    require "fileutils"
    FileUtils.mkdir_p(File.dirname(out))
    File.write(out, json)
    puts "graph → #{out}"
  else
    puts json
  end
when "timeline"
  id = ARGV.shift or abort("usage: #{Lorecraft::CLIHelp::EXE} timeline <entity-id>")
  w = load_world
  timeline = Lorecraft::Render::Timeline.new(w)
  begin
    puts(
      if format == :json
        JSON.pretty_generate(timeline.data(entity: id, at: at, audience: audience))
      else
        timeline.render(entity: id, at: at, audience: audience)
      end
    )
  rescue Lorecraft::Error => e
    abort e.message
  end
when "page"
  # One entity's rendered page, on stdout. The review app reads this so a
  # reviewer sees prose rather than source, and so an anchor taken from what they
  # highlighted matches the prose the linter checks against.
  id = ARGV.shift or abort("usage: #{Lorecraft::CLIHelp::EXE} page <entity-id>")
  w = load_world
  node = w.entity(id.tr("-", "_").to_sym) or abort("unknown entity: #{id}")
  puts Lorecraft::Render::Markdown.new(w)
                                  .page_markdown(node, year: w.timeline.now_year, audience: audience)
when "web"
  # Whether the graph holds together without its most prominent entities. The
  # work list for a tie-together pass — see craft/connecting-entities.md.
  puts Lorecraft::Web.new(load_world).report
when "queue"
  # Assembled, never authored: declared questions on entries + computed findings.
  w = load_world
  id = ARGV.shift
  begin
    query = Lorecraft::Queue.new(
      w,
      findings: w.lint(root: WORLD.root),
      entity: id&.tr("-", "_")&.to_sym,
    )
    emit(query, format)
  rescue Lorecraft::Error => e
    abort e.message
  end
when "provenance"
  # Who drafted the prose and who has read it, per block. Review dates come from
  # the DSL; whether a date still covers the text comes from git.
  id = ARGV.shift
  begin
    query = Lorecraft::Provenance.new(
      load_world,
      root: WORLD.root,
      entity: id&.tr("-", "_")&.to_sym,
    )
    emit(query, format)
  rescue Lorecraft::Error => e
    abort e.message
  end
when "facts"
  id = ARGV.shift
  begin
    query = Lorecraft::FactAudit.new(
      load_world,
      at: at,
      entity: id&.tr("-", "_")&.to_sym,
    )
    emit(query, format)
  rescue Lorecraft::Error => e
    abort e.message
  end
when "log"
  # The entry's own history: why facts changed, what corrections rest on. Not
  # world content, so it appears on no reader-facing page.
  id = ARGV.shift
  w = load_world
  nodes = id ? [w.entity(id.tr("-", "_").to_sym) || abort("unknown entity: #{id}")] : w.entities.values
  nodes.reject { |n| n.log_entries.empty? }.sort_by(&:id).each do |n|
    puts "#{n.id}:"
    n.log_entries.each { |e| puts "  #{e}" }
  end
when "stats"
  w = load_world
  puts "entities:  #{w.entities.size}"
  puts "moments:   #{w.moments.size}"
  puts "relations: #{w.relation_instances.size}"
  puts "effects:   #{w.all_effects.size}"
  kinds = w.entities.values.group_by(&:kind).transform_values(&:size).sort_by { |_, v| -v }
  puts "by kind:"
  kinds.each { |k, v| puts "  #{v.to_s.rjust(4)}  #{k}" }
else
  abort "unknown command: #{cmd}\nrun `ruby lorecraft/bin/lorecraft help`"
end
