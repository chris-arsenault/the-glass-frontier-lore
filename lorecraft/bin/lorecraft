#!/usr/bin/env ruby
# frozen_string_literal: true

# Lorecraft CLI — the day-to-day entry point. Replaces the graph_cli / lint /
# wiki_gen workflow for the DSL world.
#
#   lorecraft validate                 # load the world, run the validator
#   lorecraft render build/tree        # regenerate the markdown tree
#   lorecraft render build/wiki --audience player   # player-facing only
#   lorecraft graph [out.json]         # graph projection (Memgraph replacement)
#   lorecraft timeline <entity-id>     # life-of-entity moment strip
#   lorecraft stats
#   lorecraft worlds                   # list the tenants in worlds.yml
#
# Every command runs against exactly one world. Pick it with `--world <id>` or
# LORECRAFT_WORLD; otherwise the manifest default is used.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "lorecraft"

def opt(args, flag, default = nil)
  i = args.index(flag)
  return default unless i

  val = args[i + 1]
  args.delete_at(i + 1)
  args.delete_at(i)
  val
end

# --world is global, so it is stripped before the subcommand is read.
WORLD = begin
  Lorecraft::Worlds.find(opt(ARGV, "--world", ENV["LORECRAFT_WORLD"]))
rescue Lorecraft::Error => e
  warn e.message
  exit 2
end

# LORECRAFT_GLOB still overrides the manifest, for one-off runs over a subset.
GLOB = ENV.fetch("LORECRAFT_GLOB", WORLD.glob)

def load_world
  Lorecraft.load(GLOB, prelude: WORLD.prelude)
rescue => e
  warn "load error: #{e.message}"
  exit 2
end

cmd = ARGV.shift || "validate"
audience = opt(ARGV, "--audience", "all").to_sym
at = opt(ARGV, "--at", "now")
at = at == "now" ? :now : Integer(at)

case cmd
when "validate"
  problems = load_world.validate
  if problems.empty?
    puts "✓ world is valid"
  else
    puts "✗ #{problems.size} problem(s):"
    problems.each { |p| puts "  - #{p}" }
    exit 1
  end
when "lint"
  findings = load_world.lint
  by = findings.group_by(&:level)
  %i[info future warn error].each do |lvl|
    (by[lvl] || []).each { |f| puts "#{lvl.to_s.upcase.ljust(7)} #{f.message}" }
  end
  e = (by[:error] || []).size
  w = (by[:warn] || []).size
  fu = (by[:future] || []).size
  i = (by[:info] || []).size
  puts "\n#{'─' * 40}\n  #{e} error(s), #{w} warning(s), #{fu} future(s), #{i} to convert"
  exit(e.positive? ? 1 : 0)
when "wiki"
  out = ARGV.shift or abort("usage: lorecraft wiki OUT_DIR")
  files = load_world.render(:wiki, out: out, at: at)
  puts "generated #{files.size} wiki pages → #{out}/"
when "topology"
  w = load_world
  rels = w.relationships
  ents = w.entities.values.reject { |e| e[:status].to_s == "shell" }
  deg = Hash.new(0)
  rels.each { |s, _v, t| deg[s] += 1; deg[t] += 1 }
  degs = ents.map { |e| deg[e.id] }.sort
  n = ents.size
  mean = degs.empty? ? 0 : degs.sum.to_f / degs.size
  median = degs.empty? ? 0 : degs[degs.size / 2]
  zero = ents.select { |e| deg[e.id].zero? }
  puts "=== Topology ==="
  puts "  entities (non-shell): #{n}"
  puts "  typed edges:          #{rels.size}"
  puts "  edges/entity:         #{(rels.size.to_f / n).round(1)}  (target 4+)"
  puts "  mean degree:          #{mean.round(1)}  (target 5+)"
  puts "  median degree:        #{median}  (target 4+)"
  puts "  zero-degree:          #{zero.size}/#{n}  (target 0)"
  unless zero.empty?
    puts "  zero-degree entities:"
    zero.sort_by(&:kind).each { |e| puts "    #{e.kind.to_s.ljust(20)} #{e.id}" }
  end
when "worlds"
  Lorecraft::Worlds.all.each do |w|
    marks = [w.status, ("publishes wiki" if w.publish?)].compact.join(", ")
    default = " (default)" if w.id == Lorecraft::Worlds.default_id
    puts "  #{w.id.ljust(16)} #{w.title.ljust(24)} #{marks}#{default}"
  end
when "review"
  sub = ARGV.shift || "status"
  rt = Lorecraft::ReviewTracker.new(root: WORLD.root)
  case sub
  when "pending" then puts rt.pending
  when "mark"
    abort("usage: lorecraft review mark <file>...") if ARGV.empty?
    rt.mark(ARGV).each { |m| puts "  marked: #{m}" }
  when "status"
    s = rt.status_summary
    puts "#{s[:reviewed]}/#{s[:total]} reviewed, #{s[:pending]} pending"
  when "stale"
    r = rt.stale
    puts "#{r[:stale].size} stale, #{r[:active].size} active"
    r[:stale].each { |c| puts "  STALE #{c['file']}: #{c['comment'].to_s[0, 60]}" }
  else abort "unknown review subcommand: #{sub}"
  end
when "render"
  out = ARGV.shift or abort("usage: lorecraft render OUT_DIR [--audience player] [--at TICK]")
  w = load_world
  w.validate! rescue (warn "refusing to render an invalid world; run `lorecraft validate`"; exit 1)
  files = w.render(:markdown, out: out, audience: audience, at: at)
  puts "rendered #{files.size} pages → #{out}/"
when "graph"
  out = ARGV.shift
  json = load_world.render(:graph, audience: audience, at: at)
  if out
    require "fileutils"
    FileUtils.mkdir_p(File.dirname(out))
    File.write(out, json)
    puts "graph → #{out}"
  else
    puts json
  end
when "timeline"
  id = ARGV.shift or abort("usage: lorecraft timeline <entity-id>")
  puts load_world.render(:timeline, entity: id, at: at)
when "queue"
  # Assembled, never authored: declared questions on entries + computed findings.
  w = load_world
  puts Lorecraft::Queue.new(w, findings: w.lint(root: WORLD.root)).report
when "provenance"
  # Who drafted the prose and who has read it, per block. Review dates come from
  # the DSL; whether a date still covers the text comes from git.
  w = load_world
  rt = Lorecraft::ReviewTracker.new(root: WORLD.root)
  changed_at = lambda do |owner|
    node = w[owner]
    file = node.respond_to?(:source_file) && node.source_file
    next nil unless file

    rel = Pathname.new(file).expand_path.relative_path_from(Pathname.new(WORLD.root).expand_path).to_s
    rt.content_changed_at(rel)
  end
  puts Lorecraft::Provenance.new(w, changed_at: changed_at).report
when "log"
  # The entry's own history: why facts changed, what corrections rest on. Not
  # world content, so it appears on no reader-facing page.
  id = ARGV.shift
  w = load_world
  nodes = id ? [w.entity(id.tr("-", "_").to_sym) || abort("unknown entity: #{id}")] : w.entities.values
  nodes.reject { |n| n.log_entries.empty? }.sort_by(&:id).each do |n|
    puts "#{n.id}:"
    n.log_entries.each { |e| puts "  #{e}" }
  end
when "stats"
  w = load_world
  puts "entities:  #{w.entities.size}"
  puts "moments:   #{w.moments.size}"
  puts "relations: #{w.relation_instances.size}"
  puts "effects:   #{w.all_effects.size}"
  kinds = w.entities.values.group_by(&:kind).transform_values(&:size).sort_by { |_, v| -v }
  puts "by kind:"
  kinds.each { |k, v| puts "  #{v.to_s.rjust(4)}  #{k}" }
else
  abort "unknown command: #{cmd}\nsee the header of bin/lorecraft for usage"
end
