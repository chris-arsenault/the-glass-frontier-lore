# frozen_string_literal: true

# Engine tasks. Run from the repository root with:
#   rake -f lorecraft/Rakefile test
#   rake -f lorecraft/Rakefile smoke
#   rake -f lorecraft/Rakefile check
ROOT = File.expand_path("..", __dir__)

desc "Run the Lorecraft unit test suite"
task :test do
  sh "ruby #{__dir__}/test/test_lorecraft.rb"
end

desc "Run the hand-built end-to-end smoke world"
task :smoke do
  sh "ruby #{__dir__}/test/smoke.rb"
end

desc "Validate and lint every active repository world"
task :worlds do
  Dir.chdir(ROOT) { sh "make check-all" }
end

desc "Run engine tests and check every active world"
task check: %i[test worlds]

task default: :check
